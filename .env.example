# -----------------------------------------------------------------------------
# Environment configuration example.
# Copy this file to .env.local (or .env) and fill in real values.
# NEVER commit .env / .env.local with real secrets to version control.
# -----------------------------------------------------------------------------

# SQLite database file location (relative to project root).
# Using SQLite keeps the whole project self-contained and portable — no
# external database service is required to run or export this project.
DATABASE_URL="file:./data/app.db"

# Secret used to sign session JWTs. Must be a random string of at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-character-hex-string"

# Base URL of the application (used for links/redirects where an absolute
# URL is required). Not strictly required for local development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
